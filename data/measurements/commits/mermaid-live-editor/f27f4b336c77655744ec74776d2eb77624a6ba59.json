  "pairs": 5,
  "extra": 10,
  "extendRule": "p<0.1 && |delta|>=0.5*max(abs,rel*base)"
 },
 "env": {
  "node": "v22.20.0",
  "chrome": "Chrome/154.0.8037.59",
  "lighthouse": "13.5.0",
  "settings": {
   "formFactor": "desktop",
   "screenEmulation": {
    "mobile": false,
    "width": 1350,
    "height": 940,
    "deviceScaleFactor": 1,
    "disabled": false
   },
   "throttlingMethod": "simulate",
   "throttling": {
    "rttMs": 40,
    "throughputKbps": 10240,
    "cpuSlowdownMultiplier": 4,
    "requestLatencyMs": 0,
    "downloadThroughputKbps": 0,
    "uploadThroughputKbps": 0
   },
   "onlyAudits": [
    "largest-contentful-paint",
    "cumulative-layout-shift",
    "total-blocking-time",
    "first-contentful-paint",
    "max-potential-fid",
    "total-byte-weight",
    "bootup-time",
    "mainthread-work-breakdown",
    "dom-size-insight",
    "lcp-breakdown-insight",
    "interaction-to-next-paint",
    "metrics"
   ],
   "disableFullPageScreenshot": true
  },
  "blockedUrlPatterns": [
   "*mermaid.js.org/schemas/*"
  ],
  "lang": "en-US"
 },
 "externalHosts": {
  "external": [],
  "blocked": []
 }
}